  <Target Name="RemoveVCLibsForWindows7" BeforeTargets="ResolveAssemblyReferences">
    <Message Text="=== FORCING VCLibs removal for Windows 7 ===" Importance="high" />
    <!-- Удаляем из References -->
    <ItemGroup>
      <Reference Remove="Microsoft.VCLibs*" />
      <Reference Remove="*VCLibs*" />
    </ItemGroup>
    <!-- Также удаляем из кэша ResolveAssemblyReferences -->
    <ItemGroup>
      <_ResolveAssemblyReferenceInputAssemblies Remove="@(_ResolveAssemblyReferenceInputAssemblies)" Condition="$([System.String]::Copy('%(Filename)').Contains('VCLibs'))" />
    </ItemGroup>
  </Target>
