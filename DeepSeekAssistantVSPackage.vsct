<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidDeepSeekAssistantVSPackagePackage">

    <Groups>
      <!-- Группа для меню Tools -->
      <Group guid="guidDeepSeekAssistantVSPackagePackageCmdSet"
             id="MyMenuGroup"
             priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
    </Groups>

    <Buttons>
      <!-- Кнопка команды Open DeepSeek Chat -->
      <Button guid="guidDeepSeekAssistantVSPackagePackageCmdSet"
              id="OpenDeepSeekChatCommandId"
              priority="0x0100"
              type="Button">
        <Parent guid="guidDeepSeekAssistantVSPackagePackageCmdSet"
                id="MyMenuGroup"/>
        <Strings>
          <ButtonText>DeepSeek Chat</ButtonText>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <Symbols>
    <!-- GUID пакета (должен совпадать с PackageGuidString) -->
    <GuidSymbol name="guidDeepSeekAssistantVSPackagePackage"
                value="{cec1d5b0-52cd-4eb6-8c3a-539740e42a34}" />
	 <!-- GUID окна чата (должен совпадать с ToolWindowString в PackageIds.cs) -->
	  <GuidSymbol name="guidDeepSeekChatToolWindow"
				value="{3a13c9e9-2072-4ae1-8d25-0f2b1c14fc1d}" />
    <!-- GUID набора команд (должен совпадать с CommandSet в PackageIds.cs) -->
    <GuidSymbol name="guidDeepSeekAssistantVSPackagePackageCmdSet"
                value="{2c93c2f5-3df3-44be-b847-cfea5db0fd6d}">
      <IDSymbol name="OpenDeepSeekChatCommandId" value="0x0100"/>
      <IDSymbol name="MyMenuGroup" value="0x0200"/>
    </GuidSymbol>
  </Symbols>

</CommandTable>