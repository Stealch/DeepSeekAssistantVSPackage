<?xml version="1.0" encoding="utf-8"?>
<PackageManifest xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Stealch.DeepSeekAssistantVSPackage"
              Version="1.0.0"
              Language="en-US"
              Publisher="Stealch" />

    <DisplayName>DeepSeek Assistant</DisplayName>
    <Description xml:space="preserve">
      Visual Studio extension providing DeepSeek AI chat tool window.
    </Description>
    <MoreInfo>https://github.com/Stealch/DeepSeekAssistantVSPackage</MoreInfo>

    <InstalledProductRegistration
      ProductName="DeepSeek Assistant"
      ProductDetails="DeepSeek Assistant Visual Studio Package"
      ProductVersion="1.0.0" />
  </Metadata>

  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community"
                        Version="[16.0,18.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Pro"
                        Version="[16.0,18.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise"
                        Version="[16.0,18.0)" />
  </Installation>

  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP"
                DisplayName="Microsoft .NET Framework"
                Version="[4.8,)" />
  </Dependencies>

  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage"
           d:Source="Project"
           Path="|%CurrentProject%;DeepSeekAssistantVSPackage.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.Menus"
           d:Source="Project"
           Path="DeepSeekAssistantVSPackage.vsct" />
  </Assets>
</PackageManifest>
